<resources>
    <style name="Theme.Siddur" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Siddur.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#100E1F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Siddur</item>
    </style>
</resources>
